PORT=5000

# Konfigurasi Database PostgreSQL
# Opsi 1: Jika pakai Aiven Cloud (Cukup isi DATABASE_URL lengkap)
# DATABASE_URL=postgres://avnadmin:password@host.aivencloud.com:port/defaultdb?sslmode=require

# Opsi 2: Jika pakai PostgreSQL Lokal
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=db_servercloud

# JWT Secret Key
JWT_SECRET=supersecret_servercloud_jwt_token_key_2026

# Konfigurasi Cloudinary (Opsional, fallback otomatis ke /uploads/servers jika kosong)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
